{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradeDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "timestamp", "symbol", "action", "confidence", "rationale", "risk", "data_quality"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "symbol": {"type": "string", "minLength": 3},
    "action": {"type": "string", "enum": ["BUY", "SELL", "HOLD", "NO_TRADE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "entry_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "stop_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "target_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "risk": {
      "type": "object",
      "required": ["estimated_fee_pct", "estimated_slippage_pct", "position_size_quote"],
      "properties": {
        "estimated_fee_pct": {"type": "number", "minimum": 0},
        "estimated_slippage_pct": {"type": "number", "minimum": 0},
        "position_size_quote": {"type": "number", "minimum": 0},
        "reward_risk_ratio": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["is_fresh", "warnings"],
      "properties": {
        "is_fresh": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
